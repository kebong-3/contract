# Server-only secrets. Never use NEXT_PUBLIC_ for API keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# data.go.kr general authentication key (encoded or decoded).
DATA_GO_KR_SERVICE_KEY=

# Copy the full JSON operation request URL from your approved service's official
# utilization details. Include the appropriate query parameter with {query}.
# Optional date placeholders: {from}, {to} => yyyyMMddHHmm (last 30 days, KST).
# serviceKey/pageNo/numOfRows/type are added if needed. Only HTTPS apis.data.go.kr allowed.
# Operation URLs and query parameter names differ by service: do not reuse a bid URL for awards.
# Official service documentation:
# bid: https://www.data.go.kr/data/15129394/openapi.do
# award: https://www.data.go.kr/data/15129397/openapi.do
# shopping: https://www.data.go.kr/data/15129471/openapi.do
PROCUREMENT_BID_URL=
PROCUREMENT_AWARD_URL=
PROCUREMENT_SHOPPING_URL=

# Recommended for shared/public deployments. Set a long random access password.
# The app sends it as an Authorization: Bearer header. Empty means unrestricted.
APP_ACCESS_TOKEN=
